{
  "name": "@pocket-trash/localizations",
  "version": "0.31.0",
  "description": "Shared localization utilities and message catalogs for Pocket Trash.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./changelog/*.mdx": "./changelog/*.mdx",
    "./help/*.mdx": "./help/*.mdx",
    "./legal/*.mdx": "./legal/*.mdx"
  },
  "files": [
    "dist",
    "changelog",
    "help",
    "legal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pocket-Trash/localizations.git"
  },
  "bugs": {
    "url": "https://github.com/Pocket-Trash/localizations/issues"
  },
  "homepage": "https://github.com/Pocket-Trash/localizations#readme",
  "keywords": [
    "pocket-trash",
    "localization",
    "i18n"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "agent-skills:update": "pnpm exec skills add pocket-trash/skills --skill '*' --agent codex claude-code -y",
    "build": "pnpm run security:audit && tsc -p tsconfig.json",
    "check": "biome check --write .",
    "changelog:validate": "node scripts/validate-changelog.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/stamp-changelog-release-date.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "biome format --write .",
    "lint": "biome ci .",
    "localization:create": "node scripts/localizations.mjs create",
    "localization:sync": "node scripts/localizations.mjs sync",
    "prepack": "pnpm run build",
    "prepare": "husky",
    "release": "gh workflow run publish.yml --repo Pocket-Trash/localizations --ref main",
    "security:audit": "node scripts/security-audit.mjs",
    "test": "pnpm changelog:validate && pnpm run build && node --test"
  },
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "npm": "11.20.0",
    "skills": "1.7.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.27.1"
}
