{
  "name": "@pocket-trash/localizations",
  "version": "0.1.0",
  "description": "Shared localization utilities and message catalogs for Pocket Trash.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pocket-Trash/localizations.git"
  },
  "bugs": {
    "url": "https://github.com/Pocket-Trash/localizations/issues"
  },
  "homepage": "https://github.com/Pocket-Trash/localizations#readme",
  "keywords": [
    "pocket-trash",
    "localization",
    "i18n"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "agent-skills:check": "node scripts/agent-skills.mjs check",
    "agent-skills:install": "node scripts/agent-skills.mjs install",
    "agent-skills:update": "node scripts/agent-skills.mjs update",
    "build": "tsc -p tsconfig.json",
    "check": "biome check --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/stamp-changelog-release-date.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "biome format --write .",
    "lint": "biome ci .",
    "localization:create": "node scripts/localizations.mjs create",
    "localization:sync": "node scripts/localizations.mjs sync",
    "prepare": "husky",
    "release": "pnpm run changeset:version && pnpm install --lockfile-only && git add package.json pnpm-lock.yaml CHANGELOG.md .changeset && git commit -m \"chore: version packages [skip ci]\" && changeset publish && git push --follow-tags && VERSION=$(node -p \"require('./package.json').version\") && gh release create \"v$VERSION\" --title \"v$VERSION\" --generate-notes --verify-tag",
    "test": "pnpm run build && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "lts": "^2.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
